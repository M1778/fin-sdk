// linf_first_rules.fin -- the SDK-consumed-by-Linf proof (M1778/Fin issue #53,
// Scope C). A tool-shaped program written IN Fin against ONLY the modules this
// bundle vendors: it reads a file (fs), tokenizes it (cdk's scanner stack), and
// formats findings as diagnostics (diag). This is the shape Linf's real rule
// set will follow; Linf itself (repo, CLI, JSON output, remaining rules) is
// owned by M1778/Fin issue #50.
//
// The three rules, all running on one char pass plus one token pass:
//   1. line-length        -- a line over 100 columns is a warning (first hit).
//   2. unused-import      -- a name imported and never spelled again
//                            (v0 spelling-level rule: comments are skipped by
//                            the scanner; qualified uses like `m::x` count as
//                            uses of `m`).
//   3. delete-without-new -- a file that says `delete` but never `new`
//                            (v0 file-level rule; one diagnostic at the first
//                            `delete`).
//
// Exit codes mirror finc's shape: 0 clean, 1 findings, 2 usage/IO trouble.
// shortcut: fixed capacity (32 imported names) and first-hit sessions for
// rules 1/3 are v0 limits, upgrade when Linf owns them.

import { read_to_string, free_file_content } from fs::std;
import { CdkTokens, cdk_scan, free_cdk_tokens } from cdk::std;
import { format_warning } from diag::std;
import { tok_ident, tok_semicolon, kw_import, kw_from, kw_new, kw_delete } from token::std;
import { len, to_chars, equals, concat, free_str } from strings::std;
import { printf } from stdio::std;

priv fun warn(file: string, line: int, msg: string) <noret> {
    let text <string> = format_warning(file, line, 1, msg);
    printf("%s\n", text);
    free_str(text);
}

fun main() <int> {
    let found <int> = 0;
    let path <string> = "sample_input.fin";

    let src? <string> = read_to_string(path);
    if (src == null) {
        printf("linf: cannot read %s\n", path);
        return 2;
    }
    let text <string> = src?;

    // Rule 1: line-length. One char pass keeps line and width counters.
    let chars <[char]> = to_chars(text);
    let total <int> = len(text);
    let i <int> = 0;
    let lineno <int> = 1;
    let width <int> = 0;
    let longline <int> = 0;
    while (i < total) {
        let c <char> = chars[i];
        if (c == '\n') {
            if (width > 100 && longline == 0) {
                longline = lineno;
            }
            width = 0;
            lineno = lineno + 1;
        } else {
            width = width + 1;
        }
        i = i + 1;
    }
    if (width > 100 && longline == 0) { longline = lineno; }
    delete chars;

    // Rule 2 + 3: one token stream for both.
    let l <CdkTokens> = cdk_scan(text);
    free_file_content(text);

    // Rule 2 data: token indices of imported names, and the semicolon that
    // closes the last import, after which uses are counted.
    let names <[int]> = new [int, 32]{};
    let n_names <int> = 0;
    let after_semi <int> = -1;
    let has_delete <int> = 0;
    let has_new <int> = 0;
    let first_delete_line <int> = 0;
    let state <int> = 0; // 0 = outside, 1 = between import and from, 2 = after from
    let j <int> = 0;
    while (j < l.count) {
        let k <int> = l.tokens[j].kind;
        if (k == kw_delete() && has_delete == 0) {
            has_delete = 1;
            first_delete_line = l.tokens[j].line;
        }
        if (k == kw_new()) { has_new = 1; }
        if (state == 0) {
            if (k == kw_import()) { state = 1; }
        } else if (state == 1) {
            if (k == kw_from()) {
                state = 2;
            } else if (k == tok_ident() && n_names < 32) {
                names[n_names] = j;
                n_names = n_names + 1;
            }
        } else {
            if (k == tok_semicolon()) { after_semi = j; state = 0; }
        }
        j = j + 1;
    }

    if (longline != 0) {
        warn(path, longline, "line is longer than 100 columns");
        found = found + 1;
    }
    if (has_delete == 1 && has_new == 0) {
        warn(path, first_delete_line, "delete with no new in this file");
        found = found + 1;
    }

    let idx <int> = 0;
    while (idx < n_names) {
        let ni <int> = names[idx];
        let used <int> = 0;
        let m <int> = after_semi + 1;
        while (m < l.count) {
            if (l.tokens[m].kind == tok_ident()
                && equals(l.tokens[ni].text, l.tokens[m].text)) {
                used = 1;
            }
            m = m + 1;
        }
        if (used == 0) {
            let head <string> = concat("import '", l.tokens[ni].text);
            let msg <string> = concat(head, "' is never used in this file");
            free_str(head);
            warn(path, l.tokens[ni].line, msg);
            free_str(msg);
            found = found + 1;
        }
        idx = idx + 1;
    }
    delete names;

    free_cdk_tokens(l);
    if (found > 0) { return 1; }
    return 0;
}
